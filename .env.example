# --- Server-side (used by /api route handlers; never exposed to the client)
# PostgreSQL connection for the fused store (songs live in `fanaa`, auth in `users`).
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Set to "true" only if your DB host presents a self-signed/invalid TLS cert
# (disables certificate verification — not recommended).
#ALLOW_SELF_SIGNED_DB_SSL=false

# --- R2 media uploads (used by /api/upload; server-side only)
# Uploads go to the "Audio" and "Thumbs" folders of the bucket.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_bucket_name

# --- Client-side (public)
# Cloudflare R2 domain hosting covers + audio for preconnect hints. Replace with
# your own bucket's public domain.
NEXT_PUBLIC_R2_DOMAIN=https://your-bucket.r2.dev

# --- Seed-only (used by `npm run db:seed` to create/update the auth user)
# These two are read once by scripts/seed-user.cjs; remove after the first run.
#JIGAR_USERNAME=musafir
#JIGAR_PASSWORD=your_password